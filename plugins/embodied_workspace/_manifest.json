{
  "manifest_version": 2,
  "id": "maibot-team.embodied-workspace",
  "name": "具身动态工作区与全栈沙盒",
  "version": "1.4.0",
  "description": "提供快轨人设长文发布与慢轨 Codex/agy CLI 全栈沙盒构建、动态子域名挂载及按需唤醒后端服务",
  "author": {
    "name": "MaiBot Architect",
    "url": "https://github.com/paff67/MaiBot"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/paff67/MaiBot"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "maisaka.reply.generate",
    "maisaka.context.append",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
