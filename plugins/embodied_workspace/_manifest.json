{
  "manifest_version": 2,
  "id": "maibot-team.embodied-workspace",
  "name": "具身动态工作区与全栈沙盒",
  "version": "1.5.0",
  "description": "提供统一异步慢轨全栈沙盒构建（长文排版/交互网页/按需唤醒后端）、动态子域名交付与 Git 时光机管理",
  "author": {
    "name": "MaiBot Architect",
    "url": "https://github.com/paff67/MaiBot"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/paff67/MaiBot"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "maisaka.context.append",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}

